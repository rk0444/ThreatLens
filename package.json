{
  "name": "threatlens-v2",
  "version": "2.0.0",
  "main": "main.js",
  "description": "Unified Cybersecurity Platform",
  "author": "ThreatLens Team",
  "scripts": {
    "dev": "concurrently -k \"npm run frontend:dev\" \"npm run backend:dev\" \"npm run monitor:dev\" \"wait-on http://localhost:5173 http-get://127.0.0.1:8000 && electron .\"",
    "monitor:dev": "wait-on http-get://127.0.0.1:8000 && .venv\\Scripts\\python -u agent\\network_monitor.py",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:dev": ".venv\\Scripts\\python -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload --reload-dir backend --reload-exclude \"*.sqlite\" --reload-exclude \"*.sqlite-wal\" --reload-exclude \"*.sqlite-shm\"",
    "build": "cd frontend && npm run build && cd .. && electron-builder",
    "postinstall": "cd frontend && npm install && cd .. && pip install -r backend/requirements.txt"
  },
  "build": {
    "appId": "com.threatlens.v2",
    "productName": "ThreatLens",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/*.sqlite*",
          "!**/recovery_*/**",
          "!**/*.mmdb",
          "!**/__pycache__/**",
          "!tests/**",
          "!**/*.bak"
        ]
      },
      {
        "from": "agent",
        "to": "agent",
        "filter": [
          "network_monitor.py"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  }
}
